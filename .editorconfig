# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

# Kernel, boot code, linker scripts, debugger scripts, and course checks.
[*.{c,h,asm,ld,gdb,zsh}]
indent_style = space
indent_size = 4

# Local course site and its configuration files.
[*.{js,cjs,mjs,ts,tsx,json,css,yml,yaml}]
indent_style = space
indent_size = 2

# Preserve intentional two-space hard line breaks in Markdown.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Make recipes require literal tabs.
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
